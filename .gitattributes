# These independently pinned fixtures and vendored provenance have byte-level
# checksums. Windows checkout must not rewrite their line endings.
src/internal/pcv3operation/internal/pcv3/testdata/**/*.json text eol=lf
src/internal/pcv3operation/internal/pcv3credential/testdata/*.json text eol=lf
src/internal/pcv3operation/internal/pcv3credential/testdata/vectorfixture/main.go text eol=lf
src/internal/pcv3operation/internal/pcv3unicode/testdata/*.json text eol=lf
src/internal/pcv3operation/internal/pcv3unicode/LICENSE text eol=lf
src/internal/pcv3operation/internal/pcv3unicode/assigned17.go text eol=lf
src/internal/pcv3operation/internal/pcv3unicode/norm17/LICENSE text eol=lf
src/internal/pcv3operation/internal/pcv3unicode/norm17/*.go text eol=lf

# Gradle wrapper scripts are regenerated by Gradle and must keep platform
# line endings without storing CRLF in repository blobs.
/android/gradlew text eol=lf
/android/gradlew.bat text eol=crlf

# POSIX-format declarative artifacts must keep LF on Windows checkout.
# `core.autocrlf=true` (default on GitHub Windows runners) would otherwise
# convert these to CRLF and break distmeta contract tests + makensis/plutil.
dist/linux/*.desktop                text eol=lf
dist/linux/*.metainfo.xml           text eol=lf
dist/macos/Info.plist               text eol=lf
dist/mime/*.xml                     text eol=lf
dist/mime/*.sh                      text eol=lf
dist/snapcraft/snap/gui/*.desktop   text eol=lf
dist/snapcraft/snapcraft.yaml       text eol=lf
dist/windows/installer.nsi          text eol=lf
dist/windows/manifest.xml           text eol=lf
dist/windows/versioninfo.rc         text eol=lf
