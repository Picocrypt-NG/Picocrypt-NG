+
+// TestRenameToKeepsExisting checks that renameTo replaces what holds the name
+// only when told to. The caller that relies on this is a delete putting a name
+// back after moving the file aside, which needs the delete of a file that was
+// just renamed to fail, and nothing can arrange that, so the primitive is
+// tested instead.
+func TestRenameToKeepsExisting(t *testing.T) {
+	dir := t.TempDir()
+	for _, name := range []string{"a", "b"} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(name), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	open := func(name string, access uint32, flags uint32) syscall.Handle {
+		p, err := syscall.UTF16PtrFromString(filepath.Join(dir, name))
+		if err != nil {
+			t.Fatal(err)
+		}
+		h, err := syscall.CreateFile(p, access,
+			syscall.FILE_SHARE_READ|syscall.FILE_SHARE_WRITE|syscall.FILE_SHARE_DELETE,
+			nil, syscall.OPEN_EXISTING, flags, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return h
+	}
+	dh := open(".", syscall.GENERIC_READ, syscall.FILE_FLAG_BACKUP_SEMANTICS)
+	defer syscall.CloseHandle(dh)
+	// h holds DELETE access, which a reader that does not share deletion
+	// cannot coexist with, so it is closed before the file is read back.
+	h := open("a", windows.DELETE|windows.SYNCHRONIZE, 0)
+	closed := false
+	defer func() {
+		if !closed {
+			syscall.CloseHandle(h)
+		}
+	}()
+	b16, err := syscall.UTF16FromString("b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	b16 = b16[:len(b16)-1]
+
+	if err := windows.RenameTo(h, dh, b16, false); err == nil {
+		t.Fatal("renameTo replaced b without being asked to")
+	}
+	if data, err := os.ReadFile(filepath.Join(dir, "b")); err != nil || string(data) != "b" {
+		t.Fatalf("after the refused rename, b holds %q, %v; want %q", data, err, "b")
+	}
+	if err := windows.RenameTo(h, dh, b16, true); err != nil {
+		t.Fatal(err)
+	}
+	syscall.CloseHandle(h)
+	closed = true
+	if data, err := os.ReadFile(filepath.Join(dir, "b")); err != nil || string(data) != "a" {
+		t.Fatalf("after the rename, b holds %q, %v; want %q", data, err, "a")
+	}
+}
+
+// A deletion may give up immediate name reuse when the staging name is taken,
+// but must never replace an unrelated file to obtain it.
+func TestDeleteatFallbackKeepsExistingStagingFile(t *testing.T) {
+	windows.TestDeleteatFallback = true
+	t.Cleanup(func() { windows.TestDeleteatFallback = false })
+
+	// The staging code uses GetTempPath, whereas os.TempDir may use
+	// GetTempPath2. Create the source on the staging directory's volume.
+	n := uint32(syscall.MAX_PATH)
+	var stagingDir string
+	for {
+		buf := make([]uint16, n)
+		var err error
+		n, err = syscall.GetTempPath(uint32(len(buf)), &buf[0])
+		if err != nil || n == 0 {
+			t.Fatalf("GetTempPath: %v, length %d", err, n)
+		}
+		if n <= uint32(len(buf)) {
+			stagingDir = syscall.UTF16ToString(buf[:n])
+			break
+		}
+	}
+	for _, occupied := range []bool{true, false} {
+		t.Run(fmt.Sprintf("occupied=%t", occupied), func(t *testing.T) {
+			dir, err := os.MkdirTemp(stagingDir, "TestDeleteatFallback-")
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { os.RemoveAll(dir) })
+			source := filepath.Join(dir, "source")
+			if err := os.WriteFile(source, []byte("source"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			p, err := syscall.UTF16PtrFromString(source)
+			if err != nil {
+				t.Fatal(err)
+			}
+			h, err := syscall.CreateFile(p, syscall.GENERIC_READ,
+				syscall.FILE_SHARE_READ|syscall.FILE_SHARE_WRITE|syscall.FILE_SHARE_DELETE,
+				nil, syscall.OPEN_EXISTING, 0, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() {
+				if h != syscall.InvalidHandle {
+					syscall.CloseHandle(h)
+				}
+			}()
+			var info syscall.ByHandleFileInformation
+			if err := syscall.GetFileInformationByHandle(h, &info); err != nil {
+				t.Fatal(err)
+			}
+			stagedName := fmt.Sprintf(".go-deleted-%08x%08x", info.FileIndexHigh, info.FileIndexLow)
+			stagedPath := filepath.Join(stagingDir, stagedName)
+			var foreignInfo os.FileInfo
+			if occupied {
+				foreign, err := os.OpenFile(stagedPath, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+				if err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() { os.Remove(stagedPath) })
+				_, writeErr := foreign.WriteString("foreign")
+				// File.Stat captures the ID now; os.Stat loads it lazily by name.
+				foreignInfo, err = foreign.Stat()
+				closeErr := foreign.Close()
+				if writeErr != nil || err != nil || closeErr != nil {
+					t.Fatalf("write foreign file: %v; stat: %v; close: %v", writeErr, err, closeErr)
+				}
+			} else if _, err := os.Lstat(stagedPath); !os.IsNotExist(err) {
+				t.Fatalf("staging name is not free: %v", err)
+			}
+			dirfd, err := syscall.Open(dir, syscall.O_RDONLY, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer syscall.CloseHandle(dirfd)
+			if err := windows.Deleteat(dirfd, "source", 0); err != nil {
+				t.Fatal(err)
+			}
+			if !occupied {
+				if _, err := os.Stat(source); !os.IsNotExist(err) {
+					t.Fatalf("source name not freed while its handle remains open: %v", err)
+				}
+				entries, err := os.ReadDir(stagingDir)
+				if err != nil {
+					t.Fatal(err)
+				}
+				found := false
+				for _, entry := range entries {
+					found = found || entry.Name() == stagedName
+				}
+				if !found {
+					t.Fatal("removed file was not moved into staging")
+				}
+			}
+			if err := syscall.CloseHandle(h); err != nil {
+				t.Fatal(err)
+			}
+			h = syscall.InvalidHandle
+			if _, err := os.Stat(source); !os.IsNotExist(err) {
+				t.Fatalf("source remains after its last handle closed: %v", err)
+			}
+			if occupied {
+				data, err := os.ReadFile(stagedPath)
+				if err != nil || string(data) != "foreign" {
+					t.Fatalf("foreign staging file holds %q, %v; want %q", data, err, "foreign")
+				}
+				after, err := os.Stat(stagedPath)
+				if err != nil || !os.SameFile(foreignInfo, after) {
+					t.Fatalf("foreign staging file identity changed: %v", err)
+				}
+			} else if _, err := os.Stat(stagedPath); !os.IsNotExist(err) {
+				t.Fatalf("staged source remains after its last handle closed: %v", err)
+			}
+		})
+	}
+}
