    <string name="pcv3_consent_title">असत्यापित डेटा पुनर्प्राप्त करें?</string>
    <string name="pcv3_consent_body">यह कार्रवाई ऐसे बाइट सहेज सकती है जिनका प्रमाणीकरण नहीं हुआ है। वे अधूरे, क्षतिग्रस्त या खोलने के लिए हानिकारक हो सकते हैं। उपयोग करने के लिए सटीक भौतिक स्रोत चुनें।</string>
    <string name="pcv3_consent_role_primary">प्राथमिक कैप्सूल</string>
    <string name="pcv3_consent_role_backup">बैकअप कैप्सूल</string>
    <string name="pcv3_consent_role_d1_front">आगे का बूटस्ट्रैप</string>
    <string name="pcv3_consent_role_d1_tail">पीछे का बूटस्ट्रैप</string>
    <string name="pcv3_consent_acknowledgement">मैं समझता हूँ कि यह आउटपुट असत्यापित है।</string>
    <string name="pcv3_consent_confirm">असत्यापित डेटा पुनर्प्राप्त करें</string>
    <string name="pcv3_consent_cancel">पुनर्प्राप्ति रद्द करें</string>

