<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="io.github.picocrypt_ng.picocrypt_ng.BoundedSafGrantReceiver"
            android:exported="true"
            android:process=":bounded_provider" />
        <provider
            android:name="io.github.picocrypt_ng.picocrypt_ng.BoundedSafDocumentsProvider"
            android:authorities="io.github.picocrypt_ng.picocrypt_ng.test.bounded"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:process=":bounded_provider">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
