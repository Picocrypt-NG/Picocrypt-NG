    {"id":"T-02-14","stage":"mutation","command_id":"mutation-campaign","required_observed_ids":["M-CRD07-SELECTED-FACTOR-REMOVAL"]},
    {"id":"T-02-15","stage":"host","command_id":"host-fast-tests","required_observed_ids":["TestPhase2DisclosureSentinelMatrix"]},
    {"id":"T-02-16","stage":"host","command_id":"host-fast-tests","required_observed_ids":["TestFreezeIdentityBindsRunnerAndInspector"]},
