    {"id":"T-02-01","stage":"host","command_id":"host-fast-tests","required_observed_ids":["TestFactorModeMatrix"]},
    {"id":"T-02-02","stage":"host","command_id":"host-fast-tests","required_observed_ids":["TestCanonicalTranscriptLiteralKAT"]},
