  "skip_allowlist": [
    {
      "test": "TestUnpackAllowsSystemTempDirSymlinkPrefix",
      "reason": "temp dir path has no symlinked prefix on this platform",
      "match": "exact",
      "source_path": "internal/fileops/unpack_test.go",
      "required_go_test_declarations": 1
    }
  ],
  "skip_runtime_cardinality": {
    "minimum": 0,
    "maximum": 1
  },
  "skip_rejected_reasons": [
    "Cannot resolve temp dir symlinks on this platform:"
  ],
  "lint_runs": [
    {
      "id": "lint-normal",
      "tags": [
        "migrated_fynedo"
      ],
      "argv": [
        "${GOLANGCI_LINT}",
        "run",
        "-c",
        ".golangci.phase2.yml",
        "--build-tags",
        "migrated_fynedo",
        "--concurrency",
        "1",
        "--output.text.path",
        "/dev/null",
        "--output.json.path",
        "${STAGE_TMPDIR}/lint-normal.json",
        "./internal/pcv3credential",
        "./internal/pcv3credential/testdata/mutator",
        "./internal/pcv3credential/testdata/phasegates",
        "./internal/pcv3credential/testdata/phaseinspect"
